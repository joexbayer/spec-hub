# Copy to .env.deploy (gitignored) and fill in. bin/kamal sources it with sh, so a value can be a
# command substitution that fetches a secret at deploy time instead of storing it here, e.g.
#   BETTER_AUTH_SECRET="$(pass-cli item view --vault-name Apps --item-title spechub.example --field better_auth_secret)"

# The hub's public hostname; DNS must point at the server. TLS is issued for it automatically.
SPEC_HUB_HOST=spechub.example.com
# The server Kamal deploys to over SSH, and how to reach it.
SPEC_HUB_SERVER=203.0.113.10
SPEC_HUB_SSH_USER=root
SPEC_HUB_SSH_PORT=22

# Numeric GitHub account ids of the hub admins, comma separated (gh api users/<login> --jq .id).
SPEC_HUB_ADMINS=
# The GitHub OAuth App (callback: https://<SPEC_HUB_HOST>/api/auth/callback/github).
GITHUB_CLIENT_ID=

# Secrets.
GITHUB_CLIENT_SECRET=
BETTER_AUTH_SECRET=     # at least 32 characters: openssl rand -base64 48
POSTGRES_PASSWORD=      # openssl rand -hex 24
