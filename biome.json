{
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "enabled": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!pnpm-lock.yaml",
      "!apps/server/public",
      "!apps/server/src/db/migrations",
      "!specs",
      "!.specify",
      "!.claude",
      "!apps/web/src/routeTree.gen.ts",
      "!apps/web/src/components/ui",
      "!**/*.md",
      "!config/deploy.yml",
      "!apps/web/public"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["**/test/**"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    }
  ]
}
