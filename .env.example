# DATABASE_URL=postgres://localhost/spechub   # Homebrew postgresql@18
# PUBLIC_URL=http://localhost:5173   # the origin the browser uses; in dev that's Vite, which proxies to :3000
# BETTER_AUTH_SECRET=                         # >=32 chars; openssl rand -base64 48
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# SPEC_HUB_ADMINS=583231                 # comma list of GitHub account ids (gh api users/<login> --jq .id), not logins
# GITHUB_API_URL=https://api.github.com      # username lookups when assigning members (default)
# PORT=3000
# TRUSTED_IP_HEADER=x-real-ip                # header your TLS proxy sets to the client IP (one value); unset turns off Better Auth's rate limiter
